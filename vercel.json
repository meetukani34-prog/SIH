{
  "services": {
    "web": {
      "root": "frontend/",
      "framework": "nextjs"
    },
    "api": {
      "root": "backend/"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "api/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "web/$1"
    }
  ]
}
