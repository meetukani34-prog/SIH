# ===============================================
# AyurCTMS Backend Environment Template (.env.example)
# Copy this file to .env and fill in your values
# ===============================================

# Database Connection (Supabase PostgreSQL / Local)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# JWT Security
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Master Security Credentials
SUPERADMIN_MASTER_KEY=your-superadmin-strong-master-key-here
DEFAULT_USER_PASSWORD=your-default-user-seed-password-here

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Application Settings
APP_NAME=AyurCTMS
APP_VERSION=1.0.0
DEBUG=true

# Statutory Safety Reporting Deadline (hours)
SAE_REPORTING_DEADLINE_HOURS=24
