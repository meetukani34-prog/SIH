# ===============================================
# AyurCTMS Frontend Environment Template (.env.example)
# Copy this file to .env.local and fill in your values
# ===============================================

# Backend API endpoint
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Super Admin High-Security Master Key (set your own secret in .env.local)
NEXT_PUBLIC_SARVOTTAM_MASTER_KEY=your-super-admin-strong-key-here

# Evaluation Persona Default Password
NEXT_PUBLIC_DEMO_PASSWORD=your-demo-password-here
